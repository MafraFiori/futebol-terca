{
  "name": "futebol-terca",
  "version": "1.0.0",
  "type": "module",
  "dependencies": {
    "@cap-js-community/odata-v2-adapter": "^1.16.3",
    "@cap-js/postgres": "^3.1.3",
    "@sap/cds": "^10"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^3",
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^17.14.0",
    "jest": "^30.5.2"
  },
  "scripts": {
    "start": "cds-serve",
    "lint": "eslint .",
    "test": "jest --passWithNoTests"
  },
  "private": true,
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/test/**/*.test.js"
    ]
  },
  "engines": {
    "node": ">=22.12"
  },
  "cds": {
    "requires": {
      "db": {
        "kind": "sqlite",
        "credentials": {
          "url": ":memory:"
        }
      },
      "[production]": {
        "db": {
          "kind": "postgres",
          "schema_evolution": "auto"
        }
      },
      "[pg]": {
        "db": {
          "kind": "postgres"
        }
      }
    },
    "protocols": {
      "odata-v2": {
        "path": "/odata/v2"
      }
    }
  }
}
